<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward Authorization Header to PHP (Crucial for Apache/HostGator)
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Forward requests starting with /api to the api directory
  RewriteRule ^api/(.*)$ api/index.php [L,QSA]

  # SPA Routing: If the requested resource is not a file or directory, serve index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
